datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
  STORE_OWNER
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  address   String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  store     Store?
  ratings   Rating[]
}

model Store {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  address   String
  ownerId   Int      @unique
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ratings   Rating[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rating {
  id        Int      @id @default(autoincrement())
  rating    Int      // Should be 1 to 5
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, storeId]) // Enforces one rating per user-store pair
}
